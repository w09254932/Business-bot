# Telegram BotFather token
BOT_TOKEN=

# Telegram MTProto API credentials from https://my.telegram.org/apps
API_ID=
API_HASH=

# Long random secret used by Telegram webhook
WEBHOOK_SECRET=

# Public HTTPS URL ending in /telegram/webhook
# Leave empty to register the webhook manually.
WEBHOOK_URL=

# Private channel ID, usually -1001234567890
ARCHIVE_CHANNEL_ID=

# Use a persistent path in production
DB_PATH=data/index.sqlite3
SESSION_PATH=data/archive_bot
LOG_LEVEL=INFO
