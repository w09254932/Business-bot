# Telegram bot token from @BotFather
BOT_TOKEN=

# Random secret used as a local key. The app sends its SHA-256 hex digest
# to Telegram as the webhook secret, matching Telegram allowed characters.
WEBHOOK_SECRET=

# Optional. If empty, RENDER_EXTERNAL_URL is used automatically.
# Example: https://your-service.onrender.com
WEBHOOK_URL=

# Full Firebase service-account JSON on one line. Leave empty to disable history.
FIREBASE_CREDENTIALS_JSON=

LOG_LEVEL=INFO
